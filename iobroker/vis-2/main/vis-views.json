        "data": {
          "bindings": [],
          "html": "<div class=\"em-dashboard em-battery-page\">\n  <header class=\"em-header em-detail-header\">\n    <a class=\"em-back\" href=\"#Main\" aria-label=\"Zur Übersicht\">‹</a>\n    <div>\n      <div class=\"em-kicker\">BATTERIE</div>\n      <h1>VIS2 Read-Only V1</h1>\n      <p>Nur EOS-Battery-States · keine Rohquellen · keine Steuerung</p>\n    </div>\n    <div class=\"em-soc\">\n      <span>Summary SOC</span>\n      <strong>{0_userdata.0.EOS.Battery.Summary.SOC}%</strong>\n    </div>\n  </header>\n\n  <section class=\"em-morning-panel\" data-state=\"{0_userdata.0.EOS.Battery.Morning.Status}\">\n    <div class=\"em-morning-head\">\n      <div>\n        <span class=\"em-morning-kicker\">MORGENBLICK</span>\n        <h2>{0_userdata.0.EOS.Battery.Morning.Status}</h2>\n      </div>\n      <div class=\"em-morning-score\">\n        <span>Score</span>\n        <strong>{0_userdata.0.EOS.Battery.Morning.Score}</strong>\n      </div>\n    </div>\n    <div class=\"em-morning-grid\">\n      <article class=\"em-card\">\n        <span>SOC</span>\n        <strong>{0_userdata.0.EOS.Battery.Morning.SOC}%</strong>\n        <small>aktueller Ladezustand</small>\n      </article>\n      <article class=\"em-card\">\n        <span>Power</span>\n        <strong>{0_userdata.0.EOS.Battery.Morning.Power} W</strong>\n        <small>{0_userdata.0.EOS.Battery.Morning.Direction}</small>\n      </article>\n      <article class=\"em-card\">\n        <span>Spannung</span>\n        <strong>{0_userdata.0.EOS.Battery.Morning.Voltage} V</strong>\n        <small>aktuelle Batteriespannung</small>\n      </article>\n      <article class=\"em-card\">\n        <span>Strom</span>\n        <strong>{0_userdata.0.EOS.Battery.Morning.Current} A</strong>\n        <small>aktuelle Batterieleistung</small>\n      </article>\n      <article class=\"em-card\">\n        <span>Health</span>\n        <strong>{0_userdata.0.EOS.Battery.Morning.HealthStatus}</strong>\n        <small>{0_userdata.0.EOS.Battery.Morning.HealthScore}%</small>\n      </article>\n      <article class=\"em-card\">\n        <span>Kommunikation</span>\n        <strong>{0_userdata.0.EOS.Battery.Morning.CommunicationStatus}</strong>\n        <small>Gesamtzustand</small>\n      </article>\n    </div>\n    <div class=\"em-morning-reasons\">\n      <span>Gründe</span>\n      <strong class=\"em-list-value\">{0_userdata.0.EOS.Battery.Morning.Reasons}</strong>\n    </div>\n  </section>\n\n  <section class=\"em-battery-section\">\n    <h2>Summary</h2>\n    <div class=\"em-summary-grid\">\n      <article class=\"em-card\">\n        <span>Status</span>\n        <strong>{0_userdata.0.EOS.Battery.Summary.Status}</strong>\n        <small>Gesamtsicht der Batterie</small>\n      </article>\n      <article class=\"em-card\">\n        <span>SOC</span>\n        <strong>{0_userdata.0.EOS.Battery.Summary.SOC}%</strong>\n        <small>State of Charge</small>\n      </article>\n      <article class=\"em-card\">\n        <span>Spannung</span>\n        <strong>{0_userdata.0.EOS.Battery.Summary.Voltage} V</strong>\n        <small>Gesamtspannung</small>\n      </article>\n      <article class=\"em-card\">\n        <span>Strom</span>\n        <strong>{0_userdata.0.EOS.Battery.Summary.Current} A</strong>\n        <small>Gesamtstrom</small>\n      </article>\n      <article class=\"em-card\">\n        <span>Leistung</span>\n        <strong>{0_userdata.0.EOS.Battery.Summary.Power} W</strong>\n        <small>Gesamtleistung</small>\n      </article>\n    </div>\n  </section>\n\n  <section>\n    <div class=\"em-section-head\">\n      <h2>Communication</h2>\n      <span>LastUpdate · AgeSeconds · Status je Quelle</span>\n    </div>\n    <div class=\"em-comm-grid\">\n      <article class=\"em-card em-comm-card\">\n        <span>SmartShunt</span>\n        <strong>{0_userdata.0.EOS.Battery.Communication.SmartShunt.Status}</strong>\n        <small>{0_userdata.0.EOS.Battery.Communication.SmartShunt.AgeSeconds} s · {0_userdata.0.EOS.Battery.Communication.SmartShunt.LastUpdate}</small>\n      </article>\n      <article class=\"em-card em-comm-card\">\n        <span>Gobel / Pace BMS</span>\n        <strong>{0_userdata.0.EOS.Battery.Communication.Gobel.Status}</strong>\n        <small>{0_userdata.0.EOS.Battery.Communication.Gobel.AgeSeconds} s · {0_userdata.0.EOS.Battery.Communication.Gobel.LastUpdate}</small>\n      </article>\n      <article class=\"em-card em-comm-card\">\n        <span>Heltec</span>\n        <strong>{0_userdata.0.EOS.Battery.Communication.Heltec.Status}</strong>\n        <small>{0_userdata.0.EOS.Battery.Communication.Heltec.AgeSeconds} s · {0_userdata.0.EOS.Battery.Communication.Heltec.LastUpdate}</small>\n      </article>\n      <article class=\"em-card em-comm-card\">\n        <span>MQTT</span>\n        <strong>{0_userdata.0.EOS.Battery.Communication.MQTT.Status}</strong>\n        <small>{0_userdata.0.EOS.Battery.Communication.MQTT.AgeSeconds} s · {0_userdata.0.EOS.Battery.Communication.MQTT.LastUpdate}</small>\n      </article>\n      <article class=\"em-card em-comm-card em-comm-wide\">\n        <span>Letzte Kommunikationsbewertung</span>\n        <strong>{0_userdata.0.EOS.Battery.Communication.LastUpdate}</strong>\n        <small>Verdichtete EOS-Sicht</small>\n      </article>\n    </div>\n  </section>\n\n  <section>\n    <div class=\"em-section-head\">\n      <h2>Warnings</h2>\n      <span>Nur Kommunikationsausfall</span>\n    </div>\n    <div class=\"em-flag-grid\">\n      <div class=\"em-flag\" data-state=\"{0_userdata.0.EOS.Battery.Warnings.SmartShuntOffline}\">SmartShunt offline</div>\n      <div class=\"em-flag\" data-state=\"{0_userdata.0.EOS.Battery.Warnings.GobelOffline}\">Gobel / Pace BMS offline</div>\n      <div class=\"em-flag\" data-state=\"{0_userdata.0.EOS.Battery.Warnings.HeltecOffline}\">Heltec offline</div>\n      <div class=\"em-flag\" data-state=\"{0_userdata.0.EOS.Battery.Warnings.MQTTOffline}\">MQTT offline</div>\n    </div>\n  </section>\n\n  <section>\n    <div class=\"em-section-head\">\n      <h2>Health</h2>\n      <span>Separater, nicht-aktorischer EOS-Baustein</span>\n    </div>\n    <div class=\"em-health-grid\">\n      <article class=\"em-card\">\n        <span>Status</span>\n        <strong>{0_userdata.0.EOS.Battery.Health.Status}</strong>\n        <small>Health-Verdichtung</small>\n      </article>\n      <article class=\"em-card\">\n        <span>Score</span>\n        <strong>{0_userdata.0.EOS.Battery.Health.Score}%</strong>\n        <small>0 bis 100</small>\n      </article>\n      <article class=\"em-card em-health-wide\">\n        <span>LastUpdate</span>\n        <strong>{0_userdata.0.EOS.Battery.Health.LastUpdate}</strong>\n        <small>Letzte Bewertung</small>\n      </article>\n      <article class=\"em-card em-health-wide\">\n        <span>Reasons</span>\n        <strong class=\"em-list-value\">{0_userdata.0.EOS.Battery.Health.Reasons}</strong>\n        <small>Begruendungen der Bewertung</small>\n      </article>\n    </div>\n  </section>\n\n  <section>\n    <div class=\"em-section-head\">\n      <h2>Energy Flow</h2>\n      <span>Aktive EOS-Flow-Sicht</span>\n    </div>\n    <div class=\"em-summary-grid\">\n      <article class=\"em-card\">\n        <span>PowerBalance</span>\n        <strong>{0_userdata.0.EOS.EnergyFlow.Summary.PowerBalance} W</strong>\n        <small>Gesamte Energiebilanz</small>\n      </article>\n      <article class=\"em-card\">\n        <span>Summary Status</span>\n        <strong>{0_userdata.0.EOS.EnergyFlow.Summary.Status}</strong>\n        <small>Verdichteter Flow-Status</small>\n      </article>\n      <article class=\"em-card\">\n        <span>Grid Power</span>\n        <strong>{0_userdata.0.EOS.EnergyFlow.Grid.Power} W</strong>\n        <small>Netzleistung</small>\n      </article>\n      <article class=\"em-card\">\n        <span>PV Power</span>\n        <strong>{0_userdata.0.EOS.EnergyFlow.PV.Power} W</strong>\n        <small>PV-Leistung</small>\n      </article>\n      <article class=\"em-card\">\n        <span>House Power</span>\n        <strong>{0_userdata.0.EOS.EnergyFlow.House.Power} W</strong>\n        <small>Hauslast</small>\n      </article>\n      <article class=\"em-card\">\n        <span>Wallbox Power</span>\n        <strong>{0_userdata.0.EOS.EnergyFlow.Wallbox.Power} W</strong>\n        <small>Wallbox-Leistung</small>\n      </article>\n    </div>\n  </section>\n\n  <section>\n    <div class=\"em-section-head\">\n      <h2>SmartShunt-Grundwerte</h2>\n      <span>Nur bestehende EOS-States</span>\n    </div>\n    <div class=\"em-values-grid\">\n      <article class=\"em-card\"><span>SOC</span><strong>{0_userdata.0.EOS.Battery.SmartShunt.SOC}%</strong></article>\n      <article class=\"em-card\"><span>Spannung</span><strong>{0_userdata.0.EOS.Battery.SmartShunt.Voltage} V</strong></article>\n      <article class=\"em-card\"><span>Strom</span><strong>{0_userdata.0.EOS.Battery.SmartShunt.Current} A</strong></article>\n      <article class=\"em-card\"><span>Leistung</span><strong>{0_userdata.0.EOS.Battery.SmartShunt.Power} W</strong></article>\n      <article class=\"em-card\"><span>Verbrauchte Ah</span><strong>{0_userdata.0.EOS.Battery.SmartShunt.ConsumedAh} Ah</strong></article>\n      <article class=\"em-card\"><span>Entladeenergie</span><strong>{0_userdata.0.EOS.Battery.SmartShunt.DischargedEnergy} Wh</strong></article>\n      <article class=\"em-card\"><span>Ladeenergie</span><strong>{0_userdata.0.EOS.Battery.SmartShunt.ChargedEnergy} Wh</strong></article>\n      <article class=\"em-card\"><span>Restlaufzeit</span><strong>{0_userdata.0.EOS.Battery.SmartShunt.TimeToGo} min</strong></article>\n    </div>\n  </section>\n\n  <section>\n    <div class=\"em-section-head\">\n      <h2>Packs</h2>\n      <span>Pack-Grundwerte und Kommunikation</span>\n    </div>\n    <div class=\"em-packs em-pack-grid\">\n      <article class=\"em-pack\">\n        <div class=\"em-pack-title\"><strong>Pack 1</strong><span>{0_userdata.0.EOS.Battery.Packs.Pack1.Status}</span></div>\n        <div class=\"em-pack-values\">\n          <div><span>Spannung</span><b>{0_userdata.0.EOS.Battery.Packs.Pack1.Voltage} V</b></div>\n          <div><span>Strom</span><b>{0_userdata.0.EOS.Battery.Packs.Pack1.Current} A</b></div>\n          <div><span>Leistung</span><b>{0_userdata.0.EOS.Battery.Packs.Pack1.Power} W</b></div>\n          <div><span>Temp. max</span><b>{0_userdata.0.EOS.Battery.Packs.Pack1.TemperatureMax} °C</b></div>\n          <div><span>VDiff</span><b>{0_userdata.0.EOS.Battery.Packs.Pack1.VDiff} mV</b></div>\n          <div><span>Balancing</span><b>{0_userdata.0.EOS.Battery.Packs.Pack1.Balancing}</b></div>\n        </div>\n        <small>Kommunikation: {0_userdata.0.EOS.Battery.Packs.Pack1.Communication}</small>\n      </article>\n      <article class=\"em-pack\">\n        <div class=\"em-pack-title\"><strong>Pack 2</strong><span>{0_userdata.0.EOS.Battery.Packs.Pack2.Status}</span></div>\n        <div class=\"em-pack-values\">\n          <div><span>Spannung</span><b>{0_userdata.0.EOS.Battery.Packs.Pack2.Voltage} V</b></div>\n          <div><span>Strom</span><b>{0_userdata.0.EOS.Battery.Packs.Pack2.Current} A</b></div>\n          <div><span>Leistung</span><b>{0_userdata.0.EOS.Battery.Packs.Pack2.Power} W</b></div>\n          <div><span>Temp. max</span><b>{0_userdata.0.EOS.Battery.Packs.Pack2.TemperatureMax} °C</b></div>\n          <div><span>VDiff</span><b>{0_userdata.0.EOS.Battery.Packs.Pack2.VDiff} mV</b></div>\n          <div><span>Balancing</span><b>{0_userdata.0.EOS.Battery.Packs.Pack2.Balancing}</b></div>\n        </div>\n        <small>Kommunikation: {0_userdata.0.EOS.Battery.Packs.Pack2.Communication}</small>\n      </article>\n      <article class=\"em-pack\">\n        <div class=\"em-pack-title\"><strong>Pack 3</strong><span>{0_userdata.0.EOS.Battery.Packs.Pack3.Status}</span></div>\n        <div class=\"em-pack-values\">\n          <div><span>Spannung</span><b>{0_userdata.0.EOS.Battery.Packs.Pack3.Voltage} V</b></div>\n          <div><span>Strom</span><b>{0_userdata.0.EOS.Battery.Packs.Pack3.Current} A</b></div>\n          <div><span>Leistung</span><b>{0_userdata.0.EOS.Battery.Packs.Pack3.Power} W</b></div>\n          <div><span>Temp. max</span><b>{0_userdata.0.EOS.Battery.Packs.Pack3.TemperatureMax} °C</b></div>\n          <div><span>VDiff</span><b>{0_userdata.0.EOS.Battery.Packs.Pack3.VDiff} mV</b></div>\n          <div><span>Balancing</span><b>{0_userdata.0.EOS.Battery.Packs.Pack3.Balancing}</b></div>\n        </div>\n        <small>Kommunikation: {0_userdata.0.EOS.Battery.Packs.Pack3.Communication}</small>\n      </article>\n      <article class=\"em-pack\">\n        <div class=\"em-pack-title\"><strong>Pack 4</strong><span>{0_userdata.0.EOS.Battery.Packs.Pack4.Status}</span></div>\n        <div class=\"em-pack-values\">\n          <div><span>Spannung</span><b>{0_userdata.0.EOS.Battery.Packs.Pack4.Voltage} V</b></div>\n          <div><span>Strom</span><b>{0_userdata.0.EOS.Battery.Packs.Pack4.Current} A</b></div>\n          <div><span>Leistung</span><b>{0_userdata.0.EOS.Battery.Packs.Pack4.Power} W</b></div>\n          <div><span>Temp. max</span><b>{0_userdata.0.EOS.Battery.Packs.Pack4.TemperatureMax} °C</b></div>\n          <div><span>VDiff</span><b>{0_userdata.0.EOS.Battery.Packs.Pack4.VDiff} mV</b></div>\n          <div><span>Balancing</span><b>{0_userdata.0.EOS.Battery.Packs.Pack4.Balancing}</b></div>\n        </div>\n        <small>Kommunikation: {0_userdata.0.EOS.Battery.Packs.Pack4.Communication}</small>\n      </article>\n    </div>\n  </section>\n</div>\n\n",
