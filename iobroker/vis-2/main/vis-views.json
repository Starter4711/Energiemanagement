          "html": "<div class=\"em-dashboard em-pool-page\">\n  <header class=\"em-header em-detail-header\">\n    <a class=\"em-back\" href=\"#Main\" aria-label=\"Zur Übersicht\">‹</a>\n    <div>\n      <div class=\"em-kicker\">POOL</div>\n      <h1>Poolsteuerung</h1>\n      <p>Siemens LOGO · S7</p>\n    </div>\n    <div class=\"em-soc em-pool-temp\">\n      <span>Pool · Rücklauf</span>\n      <strong>{javascript.0.Pool.RL} °C</strong>\n    </div>\n  </header>\n\n  <section>\n    <div class=\"em-pool-temps\">\n      <article><span>Pooltemperatur</span><strong>{javascript.0.Pool.RL} °C</strong><small>Rücklauf · führender Wert</small></article>\n      <article><span>Vorlauf</span><strong>{javascript.0.Pool.VL} °C</strong><small>Indikator Wärmepumpenbetrieb</small></article>\n      <article class=\"em-state\" data-state=\"{s7.0.info.connection}\"><span>LOGO Verbindung</span><strong>{s7.0.info.connection}</strong></article>\n      <article class=\"em-state\" data-state=\"{s7.0.DBs.DB1.V0_0}\"><span>Betriebsart</span><strong>Winter: {s7.0.DBs.DB1.V0_0}</strong></article>\n    </div>\n  </section>\n\n  <section>\n    <h2>Ein- und Ausgänge</h2>\n    <div class=\"em-io-grid\">\n      <div class=\"em-state\" data-state=\"{s7.0.Inputs.0.I1}\"><span>Eingang · H2O Sensor</span><b>{s7.0.Inputs.0.I1}</b></div>\n      <div class=\"em-state\" data-state=\"{s7.0.Outputs.0.Q1}\"><span>Q1 · Pumpe</span><b>{s7.0.Outputs.0.Q1}</b></div>\n      <div class=\"em-state\" data-state=\"{s7.0.Outputs.0.Q2}\"><span>Q2 · Salz / pH</span><b>{s7.0.Outputs.0.Q2}</b></div>\n      <div class=\"em-state\" data-state=\"{s7.0.Outputs.0.Q3}\"><span>Q3 · Füllen</span><b>{s7.0.Outputs.0.Q3}</b></div>\n      <div class=\"em-state\" data-state=\"{s7.0.Outputs.0.Q4}\"><span>Q4 · Wärmepumpe</span><b>{s7.0.Outputs.0.Q4}</b></div>\n    </div>\n  </section>\n\n  <section>\n    <div class=\"em-section-head\"><h2>Betrieb</h2><a class=\"em-text-link\" href=\"#Pool_Bedienung\">Bedienung ›</a></div>\n    <div class=\