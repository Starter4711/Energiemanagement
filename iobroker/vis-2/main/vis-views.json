 </section>\n\n  <section>\n    <div class=\"em-section-head\">\n      <h2>Health</h2>\n      <span>Abgeleitete EOS-Flow-Sicht</span>\n    </div>\n    <div class=\"em-health-grid\">\n      <article class=\"em-card\">\n        <span>Status</span>\n        <strong>{0_userdata.0.EOS.Battery.Health.Status}</strong>\n        <small>Health-Verdichtung</small>\n      </article>\n      <article class=\"em-card\">\n        <span>Score</span>\n        <strong>{0_userdata.0.EOS.Battery.Health.Score}%</strong>\n        <small>0 bis 100</small>\n      </article>\n      <article class=\"em-card em-health-wide\">\n        <span>LastUpdate</span>\n        <strong>{0_userdata.0.EOS.Battery.Health.LastUpdate}</strong>\n        <small>Letzte Bewertung</small>\n      </article>\n      <article class=\"em-card em-health-wide\">\n        <span>Reasons</span>\n        <strong class=\"em-list-value\">{0_userdata.0.EOS.Battery.Health.Reasons}</strong>\n        <small>Begruendungen der Bewertung</small>\n      </article>\n    </div>\n  </section>\n\n  <section>\n    <div class=\"em-section-head\">\n      <h2>Energy Flow</h2>\n      <span>Alle belegten EOS-Teilbereiche</span>\n    </div>\n    <div class=\"em-summary-grid\">\n      <article class=\"em-card\">\n        <span>Grid 40 / 41 / 43</span>\n        <strong>{0_userdata.0.EOS.EnergyFlow.Grid.Grid40.Power} / {0_userdata.0.EOS.EnergyFlow.Grid.Grid41.Power} / {0_userdata.0.EOS.EnergyFlow.Grid.Grid43.Power} W</strong>\n        <small>Einzelwerte der Netzpunkte</small>\n      </article>\n      <article class=\"em-card\">\n        <span>PV Power</span>\n        <strong>{0_userdata.0.EOS.EnergyFlow.PV.Power} W</strong>\n        <small>PV-Leistung</small>\n      </article>\n      <article class=\"em-card\">\n        <span>House Power</span>\n        <strong>{0_userdata.0.EOS.EnergyFlow.House.Power} W</strong>\n        <small>Hauslast</small>\n      </article>\n      <article class=\"em-card\">\n        <span>Wallbox Power</span>\n        <stron