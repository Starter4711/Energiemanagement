        "tpl": "tplHtml",
        "data": {
          "bindings": [],
          "html": "<div class=\"em-dashboard em-battery-page\">\n  <header class=\"em-header em-detail-header\">\n    <a class=\"em-back\" href=\"#Main\" aria-label=\"Zur Übersicht\">‹</a>\n    <div>\n      <div class=\"em-kicker\">BATTERIE</div>\n      <h1>Zellüberwachung</h1>\n      <p>SmartShunt · Pace BMS · HELTEC</p>\n    </div>\n    <div class=\"em-soc\">\n      <span>SmartShunt</span>\n      <strong>{alias.0.Gobel.Soc SmartShunt}%</strong>\n    </div>\n  </header>\n\n  <section class=\"em-battery-section\">\n    <h2>DC-System</h2>\n    <div class=\"em-battery\">\n      <div><span>Leistung</span><strong>{alias.0.Gobel.Power} W</strong></div>\n      <div><span>Spannung · SmartShunt</span><strong>{alias.0.Gobel.Voltage_SmartShunt} V</strong></div>\n      <div><span>Strom</span><strong>{alias.0.Gobel.Current} A</strong></div>\n      <div><span>RS450</span><strong>{alias.0.MPPT RS450/100.P String1} + {alias.0.MPPT RS450/100.P String2} W</strong></div>\n    </div>\n  </section>\n\n  <section class=\"em-cells\">\n    <div class=\"em-section-head\">\n      <h2>Packs und Zellen</h2>\n      <span>Alarmgrenze 50 mV</span>\n    </div>\n    <div class=\"em-packs\">\n      <article class=\"em-pack\">\n        <div class=\"em-pack-title\"><strong>Pack 1</strong><span>SOC {alias.0.Gobel_Master.SOC}%</span></div>\n        <div class=\"em-pack-values\"><div><span>Spreizung</span><b>{0_userdata.0.Energiemanagement.Batterie.Pack1.Zellspannung.Differenz_mV} mV</b></div><div><span>BMS ↔ HELTEC</span><b>{0_userdata.0.Energiemanagement.Batterie.Pack1.BMS_Heltec_Vergleich.Max_Differenz_mV} mV</b></div></div>\n        <small>Zellalarm: {0_userdata.0.Energiemanagement.Batterie.Pack1.Zellspannung.Alarm} · Vergleich: {0_userdata.0.Energiemanagement.Batterie.Pack1.BMS_Heltec_Vergleich.Alarm}</small>\n      </article>\n      <article class=\"em-pack\">\n        <div class=\"em-pack-title\"><strong>Pack 2</strong><span>SOC {alias.0.Gobel_Slave1.SOC}%</span></div>\n        <div class=\"em-pack-values\"><div><span>Spreizung</span><b>{0_userdata.0.Energiemanagement.Batterie.Pack2.Zellspannung.Differenz_mV} mV</b></div><div><span>BMS ↔ HELTEC</span><b>{0_userdata.0.Energiemanagement.Batterie.Pack2.BMS_Heltec_Vergleich.Max_Differenz_mV} mV</b></div></div>\n        <small>Zellalarm: {0_userdata.0.Energiemanagement.Batterie.Pack2.Zellspannung.Alarm} · Vergleich: {0_userdata.0.Energiemanagement.Batterie.Pack2.BMS_Heltec_Vergleich.Alarm}</small>\n      </article>\n      <article class=\"em-pack\">\n        <div class=\"em-pack-title\"><strong>Pack 3</strong><span>SOC {alias.0.Gobel_Slave2.SOC}%</span></div>\n        <div class=\"em-pack-values\"><div><span>Spreizung</span><b>{0_userdata.0.Energiemanagement.Batterie.Pack3.Zellspannung.Differenz_mV} mV</b></div><div><span>BMS ↔ HELTEC</span><b>{0_userdata.0.Energiemanagement.Batterie.Pack3.BMS_Heltec_Vergleich.Max_Differenz_mV} mV</b></div></div>\n        <small>Zellalarm: {0_userdata.0.Energiemanagement.Batterie.Pack3.Zellspannung.Alarm} · Vergleich: {0_userdata.0.Energiemanagement.Batterie.Pack3.BMS_Heltec_Vergleich.Alarm}</small>\n      </article>\n      <article class=\"em-pack\">\n        <div class=\"em-pack-title\"><strong>Pack 4</strong><span>SOC {alias.0.Gobel_Slave3.SOC}%</span></div>\n        <div class=\"em-pack-values\"><div><span>Spreizung</span><b>{0_userdata.0.Energiemanagement.Batterie.Pack4.Zellspannung.Differenz_mV} mV</b></div><div><span>BMS ↔ HELTEC</span><b>{0_userdata.0.Energiemanagement.Batterie.Pack4.BMS_Heltec_Vergleich.Max_Differenz_mV} mV</b></div></div>\n        <small>Zellalarm: {0_userdata.0.Energiemanagement.Batterie.Pack4.Zellspannung.Alarm} · Vergleich: {0_userdata.0.Energiemanagement.Batterie.Pack4.BMS_Heltec_Vergleich.Alarm}</small>\n      </article>\n    </div>\n  </section>\n</div>\n",
